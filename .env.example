# ============================================
# ChatGPT2API 环境变量配置示例
# ============================================

# 认证密钥（必填）
CHATGPT2API_AUTH_KEY=your_secret_key_here

# 基础 URL（可选，用于生成图片 URL）
# CHATGPT2API_BASE_URL=https://your-domain.com

# ============================================
# 存储后端配置
# ============================================

# 存储后端类型（可选值: json, sqlite, postgres, git）
# 默认: json
STORAGE_BACKEND=json

# ============================================
# 数据库配置（当 STORAGE_BACKEND=sqlite/postgres 时使用）
# ============================================

# PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api

# Supabase 示例
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 示例（不指定时自动使用 data/accounts.db）
# DATABASE_URL=sqlite:///app/data/accounts.db

# ============================================
# Git 仓库配置（当 STORAGE_BACKEND=git 时使用）
# ============================================

# Git 仓库地址（必填）
# GIT_REPO_URL=https://github.com/your-username/your-private-repo.git

# Git 访问令牌（必填）
# GitHub: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GitLab: glpat-xxxxxxxxxxxxxxxxxxxx
# GIT_TOKEN=your_git_token_here

# Git 分支（可选，默认: main）
# GIT_BRANCH=main

# Git 仓库中的文件路径（可选，默认: accounts.json）
# GIT_FILE_PATH=accounts.json

# ============================================
# WARP / FlareSolverr 稳定代理配置（可选）
# ============================================

# docker-compose.warp.yml 暴露到宿主机的端口
# WARP_SOCKS_PORT=40000
# PRIVOXY_PORT=40080
# FLARESOLVERR_PORT=8191

# FlareSolverr 日志与时区
# FLARESOLVERR_LOG_LEVEL=info
# TZ=Asia/Shanghai

# Cloudflare WARP+ License Key（可选）
# WARP_LICENSE_KEY=

# 初始化 proxy_runtime 默认值
# CHATGPT2API_PROXY_RUNTIME_ENABLED=true
# CHATGPT2API_PROXY_RUNTIME_EGRESS_MODE=single_proxy
# CHATGPT2API_PROXY_RUNTIME_PROXY_URL=http://privoxy:8118
# CHATGPT2API_PROXY_RUNTIME_RESOURCE_PROXY_URL=
# CHATGPT2API_PROXY_RUNTIME_SKIP_SSL_VERIFY=false
# CHATGPT2API_PROXY_RUNTIME_RESET_STATUS_CODES=403

# Cloudflare clearance 刷新配置
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_ENABLED=true
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_MODE=flaresolverr
# CHATGPT2API_FLARESOLVERR_URL=http://flaresolverr:8191
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_TIMEOUT_SEC=60
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_REFRESH_INTERVAL=3600
# CHATGPT2API_PROXY_RUNTIME_WARM_UP_ON_START=false
# CHATGPT2API_PROXY_RUNTIME_BROWSER=chrome
# CHATGPT2API_PROXY_RUNTIME_USER_AGENT=

# ============================================
# 邮箱验证码（自动重登时读取 OpenAI 登录验证码）
# 检查连通性：uv run python scripts/check_mailboxes.py
# ============================================
# 每个邮箱是一组 MAILBOX_<名字>_* 变量，名字任取（只用字母数字）。
#   _KIND     cloudflare_temp_email | imap | gmail_api
#   _DOMAINS  这个邮箱负责哪些账号：域名后缀、完整地址或 *，逗号分隔
#             匹配优先级：完整地址 > 更长的域名 > *；子域名也算（a.040601.xyz 命中 040601.xyz）
#   其余字段见下方各类型示例。这里的配置只在第一次启动时用：在网页「巡检 → 邮箱与路由」
#   保存一次后，邮箱和路由都改存在 data/mailboxes.json，以网页为准，这里的值不再生效。
#
# 只想加载其中几个时，列出名字（不写则加载所有 MAILBOX_<名字>_* 组）：
# MAILBOXES=cf,gmail,qq

# 名字 CF / GMAIL / QQ 有默认 KIND，可以省略 _KIND。

# ── Cloudflare Temp Email（dreamhunter2333/cloudflare_temp_email）──
# MAILBOX_CF_KIND=cloudflare_temp_email
# MAILBOX_CF_BASE_URL=https://apimail.example.com      # Worker 后端地址
# MAILBOX_CF_ADMIN_PASSWORD=                           # ADMIN_PASSWORDS 里的一个
# MAILBOX_CF_SITE_PASSWORD=                            # 开了站点密码才填
# MAILBOX_CF_DOMAINS=040601.xyz,040601.com

# ── Gmail（IMAP + 应用专用密码；域名邮箱转发到这个 Gmail 时用）──
# 应用专用密码：myaccount.google.com/apppasswords（需先开两步验证）
# MAILBOX_GMAIL_KIND=imap
# MAILBOX_GMAIL_PRESET=gmail
# MAILBOX_GMAIL_USERNAME=you@gmail.com
# MAILBOX_GMAIL_APP_PASSWORD=
# MAILBOX_GMAIL_DOMAINS=peteroooooooo.com,gmail.com
# MAILBOX_GMAIL_FOLDERS=INBOX,[Gmail]/All Mail          # 被过滤到别的标签时加上

# ── QQ 邮箱（IMAP + 授权码，不是 QQ 密码；duck.com 转发到这里）──
# MAILBOX_QQ_KIND=imap
# MAILBOX_QQ_PRESET=qq
# MAILBOX_QQ_USERNAME=123456@qq.com
# MAILBOX_QQ_AUTH_CODE=
# MAILBOX_QQ_DOMAINS=duck.com

# ── 任意 IMAP（自定义服务器）──
# MAILBOX_WORK_KIND=imap
# MAILBOX_WORK_HOST=imap.example.org
# MAILBOX_WORK_PORT=993
# MAILBOX_WORK_USERNAME=
# MAILBOX_WORK_PASSWORD=
# MAILBOX_WORK_DOMAINS=example.org

# ── Gmail API（OAuth refresh token，scope gmail.readonly）──
# MAILBOX_GAPI_KIND=gmail_api
# MAILBOX_GAPI_CLIENT_ID=
# MAILBOX_GAPI_CLIENT_SECRET=
# MAILBOX_GAPI_REFRESH_TOKEN=
# MAILBOX_GAPI_DOMAINS=example.com

# 共享收件箱默认按收件人过滤，避免拿错别的账号的验证码；转发后 To 被改写时可关掉：
# MAILBOX_<名字>_REQUIRE_RECIPIENT_MATCH=false

# 等验证码最长秒数 / 查邮箱间隔秒数
# MAILBOX_OTP_TIMEOUT_SECONDS=120
# MAILBOX_POLL_INTERVAL_SECONDS=5
